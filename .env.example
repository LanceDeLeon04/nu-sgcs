# Same Supabase project as the SCS File Repository.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLISHABLE-KEY

# Only needed locally to run `npm run create-staff` (scripts/create-staff.mjs).
# Supabase Dashboard > Project Settings > API > service_role key.
# NEVER prefix this with VITE_ and never ship it to the browser -- it bypasses
# all Row Level Security, so it must stay local-only.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Email notifications (api/send-email.js), sent via Brevo's free transactional
# email API (300 emails/day, no domain verification required). NEVER prefix
# these with VITE_ -- they must stay server-only (used only inside api/).
# 1. Sign up at brevo.com (free) -> Settings > SMTP & API > API Keys > Generate a new API key.
# 2. Add + verify a "Sender" (Senders, Domains & Dedicated IPs > Senders) --
#    any email you can receive at (e.g. your Gmail) works, no domain needed.
BREVO_API_KEY=YOUR-BREVO-API-KEY
BREVO_SENDER_EMAIL=your-verified-sender@example.com
BREVO_SENDER_NAME=Council of Leaders
