# Same Supabase project as the SCS File Repository.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLISHABLE-KEY

# Only needed locally to run `npm run create-staff` (scripts/create-staff.mjs).
# Supabase Dashboard > Project Settings > API > service_role key.
# NEVER prefix this with VITE_ and never ship it to the browser -- it bypasses
# all Row Level Security, so it must stay local-only.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
