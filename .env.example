# Same Supabase project as the SCS File Repository.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLISHABLE-KEY

# Only needed locally to run `npm run create-staff` (scripts/create-staff.mjs).
# Supabase Dashboard > Project Settings > API > service_role key.
# NEVER prefix this with VITE_ and never ship it to the browser -- it bypasses
# all Row Level Security, so it must stay local-only.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Email notifications (api/send-email.js), sent via Brevo's free transactional
# email API (300 emails/day, no domain verification required). NEVER prefix
# these with VITE_ -- they must stay server-only (used only inside api/).
# 1. Sign up at brevo.com (free) -> Settings > SMTP & API > API Keys > Generate a new API key.
# 2. Add + verify a "Sender" (Senders, Domains & Dedicated IPs > Senders) --
#    any email you can receive at (e.g. your Gmail) works, no domain needed.
BREVO_API_KEY=YOUR-BREVO-API-KEY
BREVO_SENDER_EMAIL=your-verified-sender@example.com
BREVO_SENDER_NAME=Council of Leaders

# api/cron-followups.js (Vercel Cron, see the "crons" entry in vercel.json):
# sends offices a reminder every 3 days they haven't updated a forwarded
# case, and auto-closes complaints left "resolved" for 3 days. Also
# server-only -- never prefix with VITE_.
# 1. SUPABASE_SERVICE_ROLE_KEY is the same value as above -- add it in
#    Vercel too (it's normally local-only, but this scheduled job needs it
#    in production since it must read/update every office's case).
# 2. CRON_SECRET -- any random string. When set, Vercel automatically sends
#    it as `Authorization: Bearer <value>` on the request it triggers, and
#    the endpoint rejects any request that doesn't match. Strongly
#    recommended so the endpoint can't be called by anyone else.
CRON_SECRET=YOUR-RANDOM-SECRET

# Signs the director weekly-report links (/report/:token). Optional: falls back to CRON_SECRET.
# Changing it invalidates links already emailed.
REPORT_LINK_SECRET=YOUR-OTHER-RANDOM-SECRET

# Optional: your public site URL (e.g. https://complaints.example.com). Used for the report links in
# director emails. If unset, the Vercel deployment URL is used.
PUBLIC_APP_URL=
